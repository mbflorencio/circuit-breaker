    {
      "name": "5) (Opcional) Métricas",
      "item": [
        {
          "name": "GET client-service actuator/metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{client_base_url}}/actuator/metrics",
              "host": [
                "{{client_base_url}}"
              ],
              "path": [
                "actuator",
                "metrics"
              ]
            }
          },
          "response": []
        },
        {
          "name": "resilience4j",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const endpoints = [\r",
                  "        \"resilience4j.circuitbreaker.buffered.calls\",\r",
                  "        \"resilience4j.circuitbreaker.calls\",\r",
                  "        \"resilience4j.circuitbreaker.failure.rate\",\r",
                  "        \"resilience4j.circuitbreaker.not.permitted.calls\",\r",
                  "        \"resilience4j.circuitbreaker.slow.call.rate\",\r",
                  "        \"resilience4j.circuitbreaker.slow.calls\",\r",
                  "        \"resilience4j.circuitbreaker.state\"\r",
                  "];\r",
                  "\r",
                  "let index = pm.environment.get(\"index\") || 0;\r",
                  "\r",
                  "pm.environment.set(\"endpoint\", endpoints[index]);\r",
                  "\r",
                  "index++;\r",
                  "\r",
                  "if (index < endpoints.length) {\r",
                  "    pm.environment.set(\"index\", index);\r",
                  "} else {\r",
                  "    pm.environment.set(\"index\", 0);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "index",
                  "value": "2",
                  "type": "text",
                  "uuid": "8aa88c48-2f4c-4dec-ad58-9fb0e198b433"
                },
                {
                  "key": "endpoint",
