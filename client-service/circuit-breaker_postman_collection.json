        {
          "name": "GET client-service /catalog/1 (para Runner: repetir 20x)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "try {",
                  "  const json = pm.response.json();",
                  "  const source = json.source;",
                  "  console.log('Run #' + pm.info.iteration + ' -> source:', source);",
                  "",
                  "  // Contadores simples no ambiente",
                  "  const key = source === 'fallback' ? 'count_fallback' : 'count_product';",
                  "  const prev = parseInt(pm.environment.get(key) || '0', 10);",
                  "  pm.environment.set(key, String(prev + 1));",
                  "} catch (e) {",
                  "  console.log('Resposta não-JSON:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{client_base_url}}/catalog/1",
              "host": [
                "{{client_base_url}}"
              ],
              "path": [
                "catalog",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
